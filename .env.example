# Copy this file to ".env" (same folder) and fill in the values. NEVER commit ".env".
YOUTUBE_API_KEY=
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/meta/llama-3.1-8b-instruct

MAX_COMMENTS=200
WORKERS=8
BUDGET_SECONDS=24

# local = write JSON to ./local_results   |   s3 = private S3 bucket (needs BUCKET_NAME + AWS credentials)
STORAGE_MODE=local
BUCKET_NAME=
